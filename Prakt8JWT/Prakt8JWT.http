
@host = https://localhost:7097

### Вход администратора
# @name adminLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "login": "admin123",
  "password": "P@s$w0rd"
}

### Вход пользователя
# @name userLogin
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "login": "student",
  "password": "123456"
}

### Получение задач администратора
GET {{host}}/api/v1/tasks
Authorization: Bearer {{adminLogin.response.body.$.access_token}}

### Получение задач пользователя
GET {{host}}/api/v1/tasks
Authorization: Bearer {{userLogin.response.body.$.access_token}}


### Изменение задачи
PUT {{host}}/api/v1/tasks/1
Authorization: Bearer {{userLogin.response.body.$.access_token}}
Content-Type: application/json

{
  "title": "Проверка API",
  "description": "Проверить работу JWT",
  "isCompleted": true
}

### Создание задачи пользователя
POST {{host}}/api/v1/tasks
Authorization: Bearer {{userLogin.response.body.$.access_token}}
Content-Type: application/json

{
  "title": "Практическая №8",
  "description": "Реализовать JWT"
}
